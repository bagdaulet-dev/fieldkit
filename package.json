{
  "name": "fieldkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "typecheck": "tsc -p frontend/tsconfig.json",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.62.0"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5",
    "playwright": "1.62.1",
    "prettier": "3.9.10"
  },
  "packageManager": "npm@11.19.0"
}
