# Generate unique local credentials with python3 scripts/setup-env.py.
APP_PORT=8082
MYSQL_DATABASE=fieldkit
MYSQL_USER=fieldkit
MYSQL_PASSWORD=change-me-generated-by-setup-env
MYSQL_ROOT_PASSWORD=change-me-generated-by-setup-env
MYSQL_SSL_MODE=DISABLED
SECURE_COOKIES=false
DEMO_ENABLED=true
APP_TIME_ZONE=Asia/Almaty
