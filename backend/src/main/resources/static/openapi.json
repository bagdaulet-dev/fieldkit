            "schema": {
              "type": "string",
              "enum": ["ALL", "AVAILABLE", "OUT"]
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["CAMERAS", "AUDIO", "LIGHTING", "COMPUTING", "ACCESSORIES"]
