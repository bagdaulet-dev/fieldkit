{
  "openapi": "3.0.3",
  "info": {
    "title": "Fieldkit REST API",
    "version": "0.1.0",
    "description": "Private browser workspaces for equipment lending. Get /api/session first; preserve its HttpOnly cookie and send its csrfToken as X-CSRF-TOKEN on writes. No automatic write retries or idempotency keys are provided. Availability is verified transactionally."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Database readiness",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Success"
          },
          "default": {
            "description": "Structured error: 400 malformed, 403 CSRF, 404 absent/not owned, 409 stock/history conflict, 413 body too large, 415 content type, 422 validation, 429 throttle or 503 unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "summary": "Create or restore private workspace and receive CSRF token",
        "operationId": "get_session",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Structured error: 400 malformed, 403 CSRF, 404 absent/not owned, 409 stock/history conflict, 413 body too large, 415 content type, 422 validation, 429 throttle or 503 unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo": {
      "post": {
        "summary": "Populate an empty private workspace with fictional samples",
        "operationId": "post_demo",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Structured error: 400 malformed, 403 CSRF, 404 absent/not owned, 409 stock/history conflict, 413 body too large, 415 content type, 422 validation, 429 throttle or 503 unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "workspaceSession": [],
            "csrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyInput"
              }
            }
          }
        }
      }
    },
    "/api/dashboard": {
      "get": {
