  "components": {
    "schemas": {
      "EquipmentInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category", "totalQuantity"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "model": {
            "type": "string",
            "maxLength": 120
          },
          "category": {
            "type": "string",
            "enum": ["CAMERAS", "AUDIO", "LIGHTING", "COMPUTING", "ACCESSORIES"]
          },
          "location": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "totalQuantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      },
      "BorrowerInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "team": {
            "type": "string",
            "maxLength": 100
          }
        }
      },
      "LoanInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["equipmentId", "borrowerId", "quantity", "dueDate"],
        "properties": {
          "equipmentId": {
            "type": "string",
            "format": "uuid"
          },
          "borrowerId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "description": "Today through one year from today, in the configured application time zone."
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "EmptyInput": {
        "type": "object",
        "additionalProperties": false
      },
      "DeleteInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["confirmation"],
        "properties": {
          "confirmation": {
            "type": "string",
            "enum": ["DELETE"]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "isDemo": {
            "type": "boolean"
          },
          "demoEnabled": {
            "type": "boolean"
          }
        }
      },
      "Dashboard": {
        "type": "object",
        "description": "Owned equipment/unit totals, active/overdue/returned loans, borrowers, category availability, six active loans and four featured equipment records."
      },
      "Export": {
        "type": "object",
        "description": "Owned equipment, borrower and loan arrays with exportedAt; excludes session and internal workspace identifiers."
      },
      "Equipment": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "model": {
            "type": "string",
            "maxLength": 120
          },
          "category": {
            "type": "string",
            "enum": ["CAMERAS", "AUDIO", "LIGHTING", "COMPUTING", "ACCESSORIES"]
          },
          "location": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "totalQuantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
